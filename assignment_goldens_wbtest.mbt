  ]
  for case in cases {
    let (n, m, edges, optimum) = case
    let selected = solve_assignment(n, m, edges)
    let used_left = Array::make(n, false)
    let used_right = Array::make(m, false)
    let mut total = 0
    for pair in selected {
      assert_true(pair.left >= 0 && pair.left < n)
      assert_true(pair.right >= 0 && pair.right < m)
      assert_true(!used_left[pair.left])
      assert_true(!used_right[pair.right])
      assert_true(
        edges.any(fn(edge) {
          edge.left == pair.left &&
          edge.right == pair.right &&
          edge.weight == pair.weight
        }),
      )
      used_left[pair.left] = true
      used_right[pair.right] = true
      total += pair.weight
    }
    assert_eq(total, optimum)
  }
}
